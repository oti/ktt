{
  "name": "ktt",
  "version": "4.2.0",
  "private": true,
  "description": "「今朝はTKGを食べました」を一覧できるウェブサイト",
  "license": "CC BY-NC 4.0",
  "author": "oti",
  "scripts": {
    "convert2jpg": "sh scripts/convert2jpg.sh",
    "build": "node scripts/build.mjs",
    "serve": "cd dist && python3 -m http.server 3000",
    "start": "npm run update && npm run serve",
    "update": "npm run update:photo && npm run update:json && npm run build",
    "update:json": "node scripts/update-json.mjs",
    "update:photo": "node scripts/update-photo.mjs"
  },
  "devDependencies": {
    "pug": "^3.0.4",
    "sharp": "^0.35.3"
  },
  "name_jp": "今朝はTKGを食べました。"
}
